# UCE importer harness environment.
# Use with:
#   podman compose --env-file .env.importer --profile db --profile fuseki up -d
#   podman compose --env-file .env.importer --profile import run --rm uce-importer

COMPOSE_PROFILES=db,fuseki
UCE_COMPOSE_ENV_FILE=.env.importer

# Local UCE service ports for the harness.
DB_HOST=uce-postgresql-db
DB_PORT=55432
DB_RUNTIME_PORT=5432
DB_INTERNAL_PORT=5432
DB_NAME=uce_import_test
DB_USER=postgres
DB_PASSWORD=postgres
POSTGRES_IMAGE=localhost/uce-postgresql-age:local
POSTGRES_DATA_HOST_PATH=./.dev/importer-harness/postgres
POSTGRESQL_CONFIG=./database/postgresql.conf

# UCE -> PostgreSQL/Hibernate.
POSTGRESQL_CONNECTION_DRIVER_CLASS=org.postgresql.Driver
POSTGRESQL_DIALECT=org.hibernate.dialect.PostgreSQLDialect
POSTGRESQL_HIBERNATE_CURRENT_SESSION_CONTEXT_CLASS=thread
POSTGRESQL_HIBERNATE_SHOW_SQL=false
POSTGRESQL_HIBERNATE_FORMAT_SQL=false
POSTGRESQL_HIBERNATE_HBM2DDL_AUTO=update
POSTGRESQL_ENRICHMENT_LOCATION_MAX=200
POSTGRESQL_POOL_CONNECTION_TIMEOUT_MS=60000
POSTGRESQL_POOL_MINIMUM_IDLE=2
POSTGRESQL_POOL_MAXIMUM_SIZE=8
POSTGRESQL_POOL_IDLE_TIMEOUT_MS=600000
POSTGRESQL_POOL_MAX_LIFETIME_MS=1800000
POSTGRESQL_POOL_LEAK_DETECTION_THRESHOLD_MS=60000
POSTGRESQL_OPERATION_RETRY_MAX_ATTEMPTS=3
POSTGRESQL_OPERATION_RETRY_BACKOFF_MS=250
POSTGRESQL_CONNECT_TIMEOUT_SECONDS=10
POSTGRESQL_SOCKET_TIMEOUT_SECONDS=60

# Importer.
IMPORTER_THREADS=64
IMPORTER_NUMBER=1
IMPORTER_CORPORA_HOST_PATH=/home/stud_homes/s0424382/projects/ttlab/uce/biofid-nova-preprocessing/UCE/.dev/importer-harness/corpora/domain-sample
IMPORTER_IMPORT_SRC=/app/input
IMPORTER_DATABASE_HOST_PATH=./database
UCE_CONFIG_HOST_PATH=./.dev/importer-harness/commonEmpty.conf
UCE_CONFIG_CONTAINER_PATH=/app/config/commonEmpty.conf

# Optional services stay explicit. Keep disabled/empty until correctness tests need them.
MINIO_ENDPOINT=
MINIO_USERNAME=
MINIO_PWD=
MINIO_BUCKET=cas
MINIO_RETRY_MAX_ATTEMPTS=3
MINIO_RETRY_BACKOFF_MS=250

SPARQL_HOST=http://uce-fuseki-sparql:5430/
SPARQL_ENDPOINT=biofid-search/sparql
SPARQL_MAX_ENRICHMENT=100
SPARQL_CONNECT_TIMEOUT_MS=10000
SPARQL_READ_TIMEOUT_MS=60000
SPARQL_RETRY_MAX_ATTEMPTS=3
SPARQL_RETRY_BACKOFF_MS=250
TDB2_DATA=./.dev/importer-harness/tdb/biofid-search
TDB2_ENDPOINT=biofid-search
JAVA_OPTIONS=-Xmx4g

# JVM/profiling toggles used by the harness scripts.
IMPORTER_JVM_HEAP=-Xmx8g
IMPORTER_PROFILE_ENABLED=false
IMPORTER_PROFILE_SINK=stdout
IMPORTER_JFR_ENABLED=false
IMPORTER_JFR_SETTINGS=profile
IMPORTER_JFR_FILENAME=/app/importer.jfr

# AGE graph persistence. These are service-owned amortization knobs, not pipeline throttles.
UCE_AGE_DOMAIN_BATCH_SIZE=200000
UCE_AGE_ASSOCIATION_BATCH_SIZE=200000
